'use client';

import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { obterRelatorio, RelatorioApi, obterSessao, Sessao } from '@/lib/api';
import ResultadoRelatorio from '@/views/agente/ResultadoRelatorio';

export default function PaginaRelatorios() {
  const router = useRouter();
  const [sessao, setSessao] = useState<Sessao | null>(null);

  // Estados dos campos do formulário
  const [de, setDe] = useState<string>('');
  const [ate, setAte] = useState<string>('');

  // Estados de controle da requisição
  const [relatorio, setRelatorio] = useState<RelatorioApi | null>(null);
  const [carregando, setCarregando] = useState<boolean>(false);
  const [erro, setErro] = useState<string | null>(null);

  // Validação e recuperação da sessão do agente
  useEffect(() => {
    const sessaoAtual = obterSessao();
    if (!sessaoAtual) {
      router.push('/login');
    } else {
      setSessao(sessaoAtual);
    }
  }, [router]);

  async function aoSubmeter(e: React.FormEvent) {
    e.preventDefault();
    if (!de || !ate || !sessao) return;

    try {
      setCarregando(true);
      setErro(null);
      const dados = await obterRelatorio(sessao, de, ate);
      setRelatorio(dados);
    } catch (err: any) {
      setErro(err?.message || 'Falha ao carregar o relatório. Tente novamente.');
    } finally {
      setCarregando(false);
    }
  }

  const desabilitado = !de || !ate || carregando;

  return (
    <div className="p-6 flex flex-col gap-6 max-w-5xl mx-auto">
      {/* Cabeçalho */}
      <div>
        <h1 className="text-2xl font-bold text-tinta">Relatórios</h1>
        <p className="text-sm text-tintaFraca">Números de atendimento de um período.</p>
      </div>

      {/* Formulário de Seleção de Período */}
      <form
        onSubmit={aoSubmeter}
        className="bg-fundoCard p-4 rounded-lg border border-borda shadow-sm flex flex-wrap items-end justify-between gap-4"
      >
        <div className="flex flex-wrap items-center gap-4">
          <div className="flex flex-col gap-1">
            <label htmlFor="campo-de" className="text-xs font-semibold text-tinta">
              De
            </label>
            <input
              id="campo-de"
              type="date"
              value={de}
              onChange={(e) => setDe(e.target.value)}
              required
              className="border border-borda rounded-md px-3 py-1.5 text-sm bg-fundo text-tinta focus:outline-none focus:ring-2 focus:ring-marca"
            />
          </div>

          <div className="flex flex-col gap-1">
            <label htmlFor="campo-ate" className="text-xs font-semibold text-tinta">
              Até
            </label>
            <input
              id="campo-ate"
              type="date"
              min={de}
              value={ate}
              onChange={(e) => setAte(e.target.value)}
              required
              className="border border-borda rounded-md px-3 py-1.5 text-sm bg-fundo text-tinta focus:outline-none focus:ring-2 focus:ring-marca"
            />
          </div>
        </div>

        <button
          type="submit"
          disabled={desabilitado}
          className="bg-marca text-white font-medium text-sm px-5 py-2 rounded-md hover:bg-opacity-90 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {carregando ? 'Extraindo...' : 'Extrair'}
        </button>
      </form>

      {/* Faixa de Erro */}
      {erro && (
        <div className="p-3 bg-red-100 border border-red-300 text-red-700 text-sm rounded-md">
          {erro}
        </div>
      )}

      {/* Exibição do Resultado (Componente da Renata) */}
      {relatorio && <ResultadoRelatorio dados={relatorio} />}
    </div>
  );
}
